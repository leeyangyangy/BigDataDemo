# ============================================================
# SPC Analysis docker-compose environment
# Copy to .env and adjust to point at your external services:
#   cp .env.example .env
#
# ⚠️ 安全提示 (GB/T 22239-2019 等保三级要求):
#   1. 生产环境必须替换所有占位符为真实强密钥
#   2. 不要使用本文件中的示例值
#   3. 密钥长度 >= 32 字节 (HS256 要求)
#   4. 建议使用 openssl rand -base64 48 生成
# ============================================================

# ----- external MySQL -----
# 生产环境建议:
#   1. 创建专用账户 spc_app (不要使用 root)
#   2. 限制该账户仅能访问 cockpit_all_stack 数据库
MYSQL_HOST=192.168.1.106
MYSQL_PORT=3306
MYSQL_DATABASE=cockpit_all_stack
MYSQL_USER=spc_app                          # ❌ 不要使用 root
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD # 至少16位, 含大小写+数字+特殊字符

# MySQL SSL 配置 (可选, 默认关闭以兼容无 SSL 的 MySQL)
# 启用 SSL 时需同时配置 truststore:
#   MYSQL_SSL_ENABLED=true
#   MYSQL_REQUIRE_SSL=true
#   MYSQL_VERIFY_CERT=true
#   MYSQL_TRUSTSTORE_URL=file:/path/to/mysql-truststore.jks
#   MYSQL_TRUSTSTORE_PASSWORD=your_truststore_password
MYSQL_SSL_ENABLED=false

# ----- external Redis -----
REDIS_HOST=192.168.1.106
REDIS_PORT=6379
# Redis 密码 (可选, 无密码时留空)
REDIS_PASSWORD=

# ----- external RabbitMQ (生产环境必须使用非默认账户) -----
RABBITMQ_HOST=192.168.1.106
RABBITMQ_PORT=5672
RABBITMQ_USER=spc_app                         # ❌ 不要使用 root/guest
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
RABBITMQ_VHOST=collect_data_vhost

# ----- JWT 密钥 -----
# ⚠️ 生产环境必须配置 >=32 字节的强密钥
# 生成命令: openssl rand -base64 48
# 若留空, 后端将启用随机密钥 (重启后所有Token失效, 仅适合单实例)
COCKPIT_JWT_SECRET=REPLACE_WITH_YOUR_OWN_SECRET_AT_LEAST_32_BYTES_LONG_xxxxxx

# CORS 允许来源 (逗号分隔, 留空则不启用 CORS)
COCKPIT_ALLOWED_ORIGINS=https://your-production-domain.com

# ============================================================
# 安全配置清单 (生产环境部署前检查)
# ============================================================
# [ ] 生成强JWT密钥并设置 COCKPIT_JWT_SECRET
# [ ] 创建MySQL专用账户 spc_app 并限制权限
# [ ] (可选) 启用MySQL SSL连接并配置truststore
# [ ] (可选) 设置Redis密码
# [ ] 创建RabbitMQ专用账户并删除guest
# [ ] 配置HTTPS反向代理 (nginx)
# [ ] 修改默认管理员密码 (首次登录后立即修改)
# [ ] 启用日志归档和备份策略
# [ ] 配置防火墙规则, 仅开放必要端口
