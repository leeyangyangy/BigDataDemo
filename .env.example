# ============================================================
# SPC Analysis docker-compose environment
# Copy to .env and adjust to point at your external services:
#   cp .env.example .env
# ============================================================

# ----- external MySQL -----
MYSQL_HOST=192.168.1.106
MYSQL_PORT=3306
MYSQL_DATABASE=cockpit_all_stack
MYSQL_USER=root
MYSQL_PASSWORD=root

# ----- external Redis (leave REDIS_PASSWORD empty if no auth) -----
REDIS_HOST=192.168.1.106
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- external RabbitMQ -----
RABBITMQ_HOST=192.168.1.106
RABBITMQ_PORT=5672
RABBITMQ_USER=root
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=collect_data_vhost

# ----- SPC security (MUST match frontend src/utils/crypto.js) -----
# AES key/iv and JWT secret are shared by backend and frontend.
# Changing these requires updating the frontend crypto.js as well.
SPC_AES_KEY=SPC@2026#Secure!Key
SPC_AES_IV=SPC2026SecureIV16
SPC_JWT_SECRET=SPC-Process-Control-System-JWT-Secret-Key-2026-Enterprise

# Comma-separated list of allowed CORS origins.
SPC_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
