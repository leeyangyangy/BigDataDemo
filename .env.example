# ============================================================
# SPC Analysis docker-compose environment
# Copy to .env and adjust to point at your external services:
#   cp .env.example .env
#
# ⚠️ 安全提示 (GB/T 22239-2019 等保三级要求):
#   1. 生产环境必须替换所有占位符为真实强密钥
#   2. 不要使用本文件中的示例值
#   3. 密钥长度 >= 32 字节 (HS256 要求)
#   4. 建议使用 openssl rand -base64 48 生成
# ============================================================

# ----- external MySQL -----
# 生产环境建议:
#   1. 创建专用账户 spc_app (不要使用 root)
#   2. 限制该账户仅能访问 cockpit_all_stack 数据库
#   3. 启用 SSL 连接 (见下方 MYSQL_SSL 参数)
MYSQL_HOST=192.168.1.106
MYSQL_PORT=3306
MYSQL_DATABASE=cockpit_all_stack
MYSQL_USER=spc_app                          # ❌ 不要使用 root
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD # 至少16位, 含大小写+数字+特殊字符

# MySQL SSL 配置 (生产环境必须启用)
MYSQL_SSL_ENABLED=true
MYSQL_TRUSTSTORE_PATH=/app/ssl/mysql-truststore.jks
MYSQL_TRUSTSTORE_PASSWORD=REPLACE_WITH_TRUSTSTORE_PASSWORD

# ----- external Redis (生产环境必须设置密码) -----
REDIS_HOST=192.168.1.106
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD  # 生产环境必须设置

# ----- external RabbitMQ (生产环境必须使用非默认账户) -----
RABBITMQ_HOST=192.168.1.106
RABBITMQ_PORT=5672
RABBITMQ_USER=spc_app                         # ❌ 不要使用 root/guest
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
RABBITMQ_VHOST=collect_data_vhost

# ----- SPC JWT 密钥 -----
# ⚠️ 生产环境必须配置 >=32 字节的强密钥
# 生成命令: openssl rand -base64 48
# 若不设置, 后端将自动启用随机密钥 (重启后所有Token失效)
SPC_JWT_SECRET=REPLACE_WITH_YOUR_OWN_SECRET_AT_LEAST_32_BYTES_LONG_xxxxxx

# ----- AES 密钥 (已废弃) -----
# AES key/iv 已改由前端随机生成、RSA 加密上送, 见 /api/auth/key-exchange,
# 不再从环境变量读取静态值, 见 RsaKeyHolder / CryptoKeyService。
# 以下配置保留仅为向后兼容, 新部署应删除:
# SPC_AES_KEY=  (已废弃)
# SPC_AES_IV=   (已废弃)

# Comma-separated list of allowed CORS origins.
SPC_ALLOWED_ORIGINS=https://your-production-domain.com

# ============================================================
# 安全配置清单 (生产环境部署前检查)
# ============================================================
# [ ] 生成强JWT密钥并设置 SPC_JWT_SECRET
# [ ] 创建MySQL专用账户 spc_app 并限制权限
# [ ] 启用MySQL SSL连接并配置truststore
# [ ] 设置Redis密码
# [ ] 创建RabbitMQ专用账户并删除guest
# [ ] 配置HTTPS反向代理 (nginx)
# [ ] 修改默认管理员密码 (首次登录后立即修改)
# [ ] 启用日志归档和备份策略
# [ ] 配置防火墙规则, 仅开放必要端口
